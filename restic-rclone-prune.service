[Unit]
Description=Prune unreferenced data from the restic VPS repository
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=infinity
User=root
UMask=0077
Environment=RESTIC_RCLONE_CONFIG=/etc/restic-rclone-backup.conf
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/sbin/restic-rclone-backup prune
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true
